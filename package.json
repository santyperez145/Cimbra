{
  "name": "cimbra-fintech-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-next.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "start:smoke": "node scripts/smoke-standalone.mjs",
    "deploy": "npx vercel@latest --prod",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "node --env-file-if-exists=.env.local tests/ledger-db.mjs",
    "test:e2e": "node --env-file-if-exists=.env.local tests/app-e2e.mjs",
    "sdk:build": "npm run build --workspace @cimbra/sdk",
    "sdk:artifact": "node scripts/build-sdk-artifact.mjs",
    "postman:artifact": "node scripts/build-postman-collection.mjs",
    "sdk:pack": "npm pack --workspace @cimbra/sdk --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@vercel/blob": "^2.3.0",
    "drizzle-orm": "0.45.2",
    "jose": "^6.1.0",
    "next": "16.3.3",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
